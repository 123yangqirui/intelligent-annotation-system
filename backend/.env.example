APP_ENV=development
DATABASE_URL=postgresql+psycopg://annotation@127.0.0.1:55432/annotation_db
REDIS_BROKER_URL=redis://127.0.0.1:56379/0
REDIS_CACHE_URL=redis://127.0.0.1:56380/0
MONGODB_URI=mongodb://127.0.0.1:57017
# 使用 uv run python -m app.cli configure 自动生成两个密钥。
SECRET_KEY=
ENCRYPTION_KEY=
COOKIE_SECURE=false
# 远程服务按实际需要加入允许主机，不使用通配符。
PROVIDER_ALLOWED_HOSTS=127.0.0.1,localhost,api.openai.com,api.deepseek.com,dashscope.aliyuncs.com
